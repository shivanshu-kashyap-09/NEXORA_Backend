PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
CORS_ORIGIN=*

# Supabase Project Information
SUPABASE_PROJECT_NAME=NEXORA
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PROJECT_REGION=ap-southeast-2

# Supabase API & Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-or-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# PostgreSQL Connection String & Pool
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR_DATABASE_PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=nexora:

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Idempotency Cache TTL (in seconds)
IDEMPOTENCY_TTL_SECONDS=86400

# SMTP / Email Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="NEXORA Platform <noreply@nexora.io>"
