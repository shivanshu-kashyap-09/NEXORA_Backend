PORT=5000
NODE_ENV=development

# Supabase Project Information
SUPABASE_PROJECT_NAME=NEXORA
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PROJECT_REGION=ap-southeast-2

# Supabase API & Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-or-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR_DATABASE_PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRES_IN=15m
